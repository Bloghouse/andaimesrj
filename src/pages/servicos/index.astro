---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import pageData from '../../data/pages/servicos.json';

const servicos = await getCollection('servicos');
const config = pageData.index_page;
---

<Layout title={config.seo.meta_title} description={config.seo.meta_description}>
	<main>
		<section class={`py-32 ${config.hero_section.bg_color}`}>
			<div class="container">
				<div class="max-w-4xl mb-24">
					<span class="text-primary font-black uppercase tracking-widest mb-6 block">{config.hero_section.badge_text}</span>
					<h1 class="text-4xl md:text-7xl font-black text-slate-950 mb-8 leading-[1.1] tracking-tighter">
						{config.hero_section.title.text_normal_1}<span class="text-primary">{config.hero_section.title.text_highlight}</span>{config.hero_section.title.text_normal_2}
					</h1>
					<p class="text-xl text-slate-600 font-medium leading-relaxed">
						{config.hero_section.subtitle}
					</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
					{servicos.map((servico) => (
						<a 
							href={`/servicos/${servico.slug}`} 
							class={`bg-white p-12 rounded-[2.5rem] border border-slate-100 hover:shadow-2xl transition-all group shadow-sm ${config.layout_cards.enable_card_hover_scale ? 'hover:scale-105' : ''}`}
						>
							<div class={`w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-8 transition-colors ${config.layout_cards.enable_icon_bg_hover ? 'group-hover:bg-primary' : ''}`}>
								{servico.data.icon ? (
									<span class="text-3xl transition-transform group-hover:scale-110">{servico.data.icon}</span>
								) : (
									<svg xmlns="http://www.w3.org/2000/svg" class={`h-8 w-8 text-primary transition-colors ${config.layout_cards.enable_icon_bg_hover ? 'group-hover:text-white' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								)}
							</div>
							<h3 class="text-2xl font-black text-slate-950 mb-6 tracking-tighter group-hover:text-primary transition-colors">{servico.data.title}</h3>
							<p class="text-slate-600 font-medium leading-relaxed mb-8">
								{servico.data.description}
							</p>
							<span class="text-primary font-black uppercase text-xs tracking-widest flex items-center gap-2 group-hover:gap-4 transition-all">
								{config.layout_cards.card_link_label} <span>→</span>
							</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>
