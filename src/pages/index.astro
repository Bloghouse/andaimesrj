---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { readData } from '../lib/readData';

const pageData = readData('pages/home.json');
const globalData = readData('pages/globais.json');

const servicos = await getCollection('servicos');
---

<Layout title={pageData.seo.meta_title} description={pageData.seo.meta_description}>
	<main>
		<!-- 1. Hero Section -->
		<section class="relative min-h-[85vh] flex items-center bg-slate-950 overflow-hidden">
			<div class="absolute inset-0 opacity-30">
				<div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent z-10"></div>
				<!-- Imagem de fundo dinâmica recuperada do banco de dados JSON -->
				<div 
					class="w-full h-full bg-cover bg-center" 
					style={{ backgroundImage: `url('${pageData.hero_section.bg_image_url}')` }}
				></div>
			</div>
			
			<div class="container relative z-20 pt-20">
				<div class="max-w-4xl">
					<span class="inline-block px-5 py-2.5 bg-primary/10 border border-primary/30 text-primary text-xs font-black uppercase tracking-[0.3em] rounded-full mb-8 italic">
						{pageData.hero_section.badge_text}
					</span>
					<h1 class="text-5xl md:text-8xl font-black leading-[1] text-white mb-8 tracking-tighter italic">
						{pageData.hero_section.title.text_white_1} <br/> {pageData.hero_section.title.text_white_2} <span class="text-primary uppercase not-italic block md:inline">{pageData.hero_section.title.text_highlight}</span>
					</h1>
					<p class="text-xl md:text-2xl text-gray-200 max-w-2xl leading-relaxed mb-12 font-medium">
						{pageData.hero_section.description}
					</p>
					<div class="flex flex-col sm:flex-row gap-6">
						<a href={`https://wa.me/${globalData.contact_info.whatsapp}`} target="_blank" class="inline-flex items-center justify-center bg-primary text-white px-10 py-6 rounded-2xl text-lg font-black hover:scale-105 active:scale-95 transition-all shadow-2xl shadow-primary/30">
							{pageData.hero_section.primary_btn.label}
						</a>
						<a href={pageData.hero_section.secondary_btn.url} class="inline-flex items-center justify-center bg-white/5 border-2 border-white/20 text-white px-10 py-6 rounded-2xl text-lg font-black hover:bg-white hover:text-secondary hover:scale-105 active:scale-95 transition-all backdrop-blur-sm">
							{pageData.hero_section.secondary_btn.label}
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- 2. Diferenciais -->
		<section class="bg-white">
			<div class="container">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
					{pageData.differentials_section.items.map((item) => (
						<div class="p-10 bg-slate-50 rounded-3xl border border-slate-100 hover:border-primary hover:scale-105 transition-all group">
							<div class={`text-4xl mb-6 transition-transform ${pageData.differentials_section.enable_icon_rotation_hover ? 'group-hover:rotate-12' : ''}`}>
								{item.icon_emoji}
							</div>
							<h3 class="text-xl font-black text-slate-900 mb-4 tracking-tighter">{item.title}</h3>
							<p class="text-slate-600 leading-relaxed font-medium">{item.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 3. Sobre -->
		<section class="bg-slate-50 overflow-hidden">
			<div class="container">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-center">
					<div class="relative group">
						<div class="aspect-square bg-slate-200 rounded-[2.5rem] overflow-hidden shadow-2xl transform group-hover:-rotate-2 transition-transform duration-500">
							<img src={pageData.about_section.main_image_url} alt="Equipe Andaime Pro" class="w-full h-full object-cover"/>
						</div>
						{pageData.about_section.floating_badge.visible && (
							<div class="absolute -bottom-10 -right-10 w-52 h-52 bg-primary rounded-3xl flex items-center justify-center p-8 shadow-2xl shadow-primary/40 hidden md:flex animate-bounce-slow">
								<p class="text-white font-black text-center leading-tight">
									<span class="text-6xl block mb-2 tracking-tighter">{pageData.about_section.floating_badge.number}</span> {pageData.about_section.floating_badge.text}
								</p>
							</div>
						)}
					</div>
					<div>
						<h2 class="text-4xl md:text-6xl font-black text-slate-950 mb-8 leading-[1.1] tracking-tighter">
							{pageData.about_section.title.text_normal_1} <span class="text-primary">{pageData.about_section.title.text_highlight}</span> {pageData.about_section.title.text_normal_2}
						</h2>
						<p class="text-xl text-slate-600 mb-8 leading-relaxed font-medium">
							{pageData.about_section.description}
						</p>
						<a href={pageData.about_section.link_cta.url} class="inline-flex items-center gap-4 text-primary font-black text-xl group hover:gap-6 transition-all active:scale-95">
							{pageData.about_section.link_cta.label}
							<span class="text-2xl transition-transform group-hover:translate-x-2">→</span>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. Equipamentos -->
		<section id="servicos" class="bg-white">
			<div class="container">
				<div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-20 text-center md:text-left">
					<div class="max-w-2xl">
						<h2 class="text-4xl md:text-6xl font-black text-slate-950 mb-6 tracking-tighter">{pageData.services_preview_section.title}</h2>
						<p class="text-xl text-slate-600 font-medium">{pageData.services_preview_section.subtitle}</p>
					</div>
					<a href={pageData.services_preview_section.top_btn.url} class="bg-slate-950 text-white px-8 py-5 rounded-2xl font-black hover:scale-105 active:scale-95 transition-all shadow-xl shadow-slate-950/20">
						{pageData.services_preview_section.top_btn.label}
					</a>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					{servicos.map((servico) => (
						<a href={`/servicos/${servico.slug}`} class="bg-slate-50 p-12 rounded-[2rem] border border-slate-100 hover:shadow-2xl hover:scale-[1.03] transition-all group">
							<div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center mb-8 shadow-lg group-hover:bg-primary transition-colors">
								{servico.data.icon ? (
									<span class="text-3xl transition-transform group-hover:scale-110">{servico.data.icon}</span>
								) : (
									<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
									</svg>
								)}
							</div>
							<h3 class="text-2xl font-black text-slate-950 mb-6 tracking-tighter">{servico.data.title}</h3>
							<p class="text-slate-600 font-medium leading-relaxed mb-8">{servico.data.description}</p>
							<span class="text-primary font-black uppercase text-sm tracking-wider flex items-center gap-2 group-hover:gap-4 transition-all">
								{pageData.services_preview_section.card_link_label} <span>→</span>
							</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- 5. Depoimentos -->
		<section class="bg-slate-950 text-white">
			<div class="container text-center">
				<div class="max-w-3xl mx-auto mb-20">
					<h2 class="text-4xl md:text-6xl font-black mb-8 tracking-tighter text-primary">{pageData.testimonials_section.title_highlight}</h2>
					<p class="text-xl text-gray-100 font-medium opacity-90 italic">{pageData.testimonials_section.subtitle}</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{pageData.testimonials_section.items.map((item) => (
						<div class="bg-white/5 p-12 rounded-[2.5rem] border border-white/10 hover:bg-white/10 transition-all text-left group">
							<div class="flex gap-1 mb-8">
								{Array.from({ length: item.stars_count }).map(() => <span class="text-primary text-xl">★</span>)}
							</div>
							<p class="text-lg text-gray-100 font-medium italic leading-relaxed mb-10 group-hover:text-white transition-colors">
								"{item.quote}"
							</p>
							<div class="flex items-center gap-4 border-t border-white/10 pt-8">
								{item.avatar_url ? (
									<img 
										src={item.avatar_url} 
										alt={item.author} 
										class="w-14 h-14 rounded-full border border-primary/30 object-cover shadow-inner" 
									/>
								) : (
									<div class="w-14 h-14 bg-primary/20 rounded-full border border-primary/30 flex items-center justify-center text-primary">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
										</svg>
									</div>
								)}
								<div>
									<p class="font-black text-white">{item.author}</p>
									<p class="text-sm text-primary font-bold">{item.company_role}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 6. CTA Final -->
		<section class="bg-primary relative overflow-hidden">
			<!-- Decoração de fundo -->
			<div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-[600px] h-[600px] bg-white/10 rounded-full blur-3xl"></div>
			
			<div class="container text-center relative z-10">
				<h2 class="text-5xl md:text-8xl font-black text-white mb-10 leading-tight tracking-[calc(-0.05em)]">
					{pageData.footer_cta_section.title.text_normal_1} <br class="hidden md:block"/> {pageData.footer_cta_section.title.text_normal_2} <span class="bg-white text-primary px-4 selection:bg-slate-900 selection:text-white">{pageData.footer_cta_section.title.text_highlight}</span>
				</h2>
				<p class="text-xl md:text-2xl font-bold text-white mb-16 opacity-95 max-w-2xl mx-auto">
					{pageData.footer_cta_section.description}
				</p>
				<div class="flex flex-col md:flex-row justify-center gap-8">
					<a href={`https://wa.me/${globalData.contact_info.whatsapp}`} class="bg-slate-950 text-white px-12 py-8 rounded-[2rem] text-2xl font-black hover:scale-105 active:scale-95 transition-all shadow-2xl flex items-center justify-center gap-4 group">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 group-hover:text-primary transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.588-5.946 0-6.556 5.332-11.888 11.888-11.888 3.176 0 6.161 1.237 8.404 3.483 2.247 2.246 3.483 5.232 3.483 8.405 0 6.556-5.334 11.89-11.888 11.89-2.016 0-3.991-.512-5.748-1.487l-6.238 1.636zm5.066-5.067l.311.185c1.516.902 3.268 1.378 5.071 1.378 5.424 0 9.837-4.412 9.837-9.837 0-2.628-1.024-5.101-2.88-6.958-1.856-1.857-4.327-2.881-6.957-2.881-5.424 0-9.838 4.413-9.838 9.838 0 2.158.7 4.259 2.019 6.002l.232.308-1.002 3.664 3.757-.985zm11.332-5.477c-.285-.144-1.687-.832-1.947-.927-.261-.096-.451-.144-.641.144-.19.287-.736.927-.903 1.118-.166.19-.332.215-.617.072-.285-.144-1.204-.444-2.293-1.415-.848-.756-1.42-1.689-1.586-1.976-.166-.287-.018-.442.125-.584.128-.128.285-.335.428-.503.142-.167.19-.287.285-.479.095-.19.047-.359-.024-.503-.071-.144-.641-1.545-.878-2.12-.231-.559-.465-.483-.64-.492-.166-.008-.356-.01-.546-.01s-.499.072-.76.359c-.261.287-1 0.978-1 2.388s1.021 2.774 1.164 2.965c.143.19 2.009 3.067 4.868 4.301.68.293 1.21.469 1.623.6s.785.056 1.081.012c.33-.049 1.365-.558 1.556-1.099.19-.54.19-1.006.133-1.1-.057-.094-.214-.144-.499-.286z"/></svg>
						{pageData.footer_cta_section.whatsapp_btn_label}
					</a>
					<a href={`tel:${globalData.contact_info.phone}`} class="bg-white text-primary px-12 py-8 rounded-[2rem] text-2xl font-black hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-4 shadow-xl">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
						</svg>
						{pageData.footer_cta_section.phone_btn_label_prefix}{globalData.contact_info.phone}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	@keyframes bounce-slow {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-20px); }
	}
	.animate-bounce-slow {
		animation: bounce-slow 4s infinite ease-in-out;
	}
</style>
