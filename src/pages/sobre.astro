---
import Layout from '../layouts/Layout.astro';
import { readData } from '../lib/readData';

const pageData = readData('pages/sobre.json');
---

<Layout title={pageData.seo.meta_title} description={pageData.seo.meta_description}>
	<main>
		<!-- 1. Hero Institucional -->
		<section class={`py-32 text-white overflow-hidden relative ${pageData.hero_section.bg_color}`}>
			<div class="container relative z-10">
				<div class="max-w-4xl">
					<span class="text-primary font-black uppercase tracking-widest mb-6 block">{pageData.hero_section.badge_text}</span>
					<h1 class="text-4xl md:text-7xl font-black mb-12 leading-[1.1] tracking-tighter">
						{pageData.hero_section.title.text_normal_1} <span class="text-primary">{pageData.hero_section.title.text_highlight}</span> {pageData.hero_section.title.text_normal_2}
					</h1>
					<p class="text-xl md:text-2xl text-gray-100 leading-relaxed max-w-2xl opacity-90 font-medium">
						{pageData.hero_section.description}
					</p>
				</div>
			</div>
			{pageData.hero_section.enable_geometric_background && (
				<div class="absolute right-0 bottom-0 w-1/2 h-full bg-primary/5 -skew-x-12 translate-x-32 border-l border-primary/10"></div>
			)}
		</section>

		<!-- 2. Missão, Visão e Valores -->
		<section class={pageData.mvv_section.bg_color}>
			<div class="container">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
					{pageData.mvv_section.items.map((card) => (
						<div class={`p-12 bg-slate-50 rounded-[2.5rem] border border-slate-100 hover:border-primary transition-all shadow-xl shadow-slate-200/50 group ${pageData.mvv_section.enable_card_hover_effects ? 'hover:scale-105' : ''}`}>
							<div class="w-16 h-16 bg-slate-950 text-white rounded-2xl flex items-center justify-center mb-8 text-3xl group-hover:bg-primary transition-colors shadow-lg">
								{card.icon_emoji}
							</div>
							<h3 class="text-2xl font-black text-slate-950 mb-6 tracking-tighter">{card.title}</h3>
							<p class="text-lg text-slate-600 leading-relaxed font-medium">
								{card.description}
							</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 3. Compromisso com a Segurança -->
		<section class={`relative overflow-hidden ${pageData.security_section.bg_color}`}>
			<div class="container">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-center">
					<div>
						<h2 class="text-4xl md:text-6xl font-black text-slate-950 mb-8 leading-[1.1] tracking-tighter">
							{pageData.security_section.title.text_normal_1} <span class="text-primary">{pageData.security_section.title.text_highlight}</span> {pageData.security_section.title.text_normal_2}
						</h2>
						<div class="space-y-8 text-xl text-slate-600 font-medium">
							<p>
								{pageData.security_section.intro_text}
							</p>
							<ul class="space-y-6">
								{pageData.security_section.bullet_points.map((item) => (
									<li class="flex items-center gap-4 group">
										<span class="w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-black group-hover:scale-110 transition-transform shadow-lg shadow-primary/20">✓</span>
										{item}
									</li>
								))}
							</ul>
						</div>
					</div>
					<div class="aspect-video bg-slate-200 rounded-[3rem] shadow-2xl relative overflow-hidden group">
						<img 
							src={pageData.security_section.illustration.image_url} 
							alt="Inspeção de Segurança Técnica" 
							class={`w-full h-full object-cover transition-transform duration-700 ${pageData.security_section.illustration.enable_zoom_hover ? 'group-hover:scale-110' : ''}`}
						/>
						<div class={`absolute inset-0 bg-slate-950/20 transition-colors ${pageData.security_section.illustration.enable_overlay_fade_hover ? 'group-hover:bg-transparent' : ''}`}></div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. Nossa Equipe -->
		<section class={pageData.team_section.bg_color}>
			<div class="container text-center max-w-5xl mx-auto">
				<h2 class="text-4xl md:text-6xl font-black text-slate-950 mb-8 tracking-tighter">{pageData.team_section.title}</h2>
				<p class="text-xl md:text-2xl text-slate-600 mb-16 font-medium leading-relaxed">
					{pageData.team_section.subtitle}
				</p>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-8">
					{pageData.team_section.members.map((dept) => (
						<div class="space-y-6 group">
							<div class="aspect-square bg-slate-100 rounded-[2rem] overflow-hidden shadow-lg group-hover:shadow-primary/10 group-hover:scale-105 transition-all">
								<img 
									src={dept.photo_url} 
									alt={dept.area_name} 
									class={`w-full h-full object-cover transition-all ${pageData.team_section.enable_grayscale_hover ? 'grayscale group-hover:grayscale-0' : ''}`}
								/>
							</div>
							<p class="text-xl font-black text-slate-950 tracking-tighter">{dept.area_name.toUpperCase()}</p>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>
