---
import Layout from '../layouts/Layout.astro';
import { readData } from '../lib/readData';
import { marked } from 'marked';

export const prerender = false;

const pageData = readData('pages/privacidade.json');
const { seo, page_header, legal_content } = pageData;

const rawMarkdown = legal_content?.rich_text_markdown || '';
const htmlContent = await marked.parse(rawMarkdown);
---

<Layout title={seo.meta_title} description={seo.meta_description}>
	<main>
		<section class="py-32">
			<div class="container">
				<div class="max-w-4xl mx-auto">
					<h1 class="text-4xl md:text-6xl font-black text-slate-900 mb-16 leading-tight">
						{page_header.title}
					</h1>
					
					{/* Renderizando via Tailwind Typography (Prose) com markup HTML válido e limpo */}
					<article class="prose prose-2xl prose-slate max-w-none prose-headings:text-slate-950 prose-headings:font-black prose-p:text-slate-600 prose-p:font-medium prose-p:leading-relaxed">
						<div set:html={htmlContent}></div>
					</article>
				</div>
			</div>
		</section>
	</main>
</Layout>
