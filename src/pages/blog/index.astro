---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import pageData from '../../data/pages/blog.json';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const config = pageData.index_page;
---

<Layout title={config.seo.meta_title} description={config.seo.meta_description}>
	<main>
		<section class={`py-32 ${config.hero_section.bg_color}`}>
			<div class="container">
				<div class="max-w-4xl mb-24">
					<span class="text-primary font-black uppercase tracking-widest mb-6 block">{config.hero_section.badge_text}</span>
					<h1 class="text-4xl md:text-7xl font-black text-slate-950 mb-8 leading-[1.1] tracking-tighter">
						{config.hero_section.title.text_normal_1}<span class="text-primary">{config.hero_section.title.text_highlight}</span>{config.hero_section.title.text_normal_2}
					</h1>
					<p class="text-xl text-slate-600 font-medium leading-relaxed">
						{config.hero_section.subtitle}
					</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-16">
					{posts.map((post) => {
						const postImg = post.data.heroImage || config.layout_cards.fallback_image_url;
						return (
							<article class="group">
								<a href={`/blog/${post.slug}`} class="block overflow-hidden rounded-[2.5rem] mb-8 shadow-2xl shadow-slate-200 relative">
									<div 
										class={`aspect-video bg-slate-200 transition-transform duration-700 bg-cover bg-center ${config.layout_cards.enable_image_zoom_hover ? 'group-hover:scale-110' : ''}`}
										style={{ backgroundImage: `url('${postImg}')` }}
									>
										<div class={`absolute inset-0 bg-slate-950/20 transition-colors ${config.layout_cards.enable_overlay_fade_hover ? 'group-hover:bg-transparent' : ''}`}></div>
									</div>
								</a>
								<div class="space-y-6 px-4">
									<p class="text-xs font-black text-primary uppercase tracking-[0.2em]">
										{post.data.pubDate.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}
									</p>
									<h2 class="text-3xl font-black text-slate-950 hover:text-primary transition-colors tracking-tighter leading-tight">
										<a href={`/blog/${post.slug}`}>{post.data.title}</a>
									</h2>
									<p class="text-lg text-slate-600 leading-relaxed font-medium">
										{post.data.description}
									</p>
									<a href={`/blog/${post.slug}`} class="text-slate-950 font-black inline-flex items-center gap-2 group-hover:gap-4 transition-all">
										{config.layout_cards.read_more_label} <span class="text-primary">→</span>
									</a>
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>
	</main>
</Layout>
