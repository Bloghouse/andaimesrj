---
import globalData from '../data/pages/globais.json';
const info = globalData.contact_info;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": globalData.identity.company_name,
  "image": `${info.domain}${globalData.identity.logo_url}`,
  "@id": `${info.domain}`,
  "url": info.domain,
  "telephone": info.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": info.address.street,
    "addressLocality": info.address.city,
    "addressRegion": info.address.state,
    "postalCode": info.address.zip,
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -22.9068, // Coordenadas aproximadas do Centro do RJ
    "longitude": -43.1729
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "opens": "08:00",
    "closes": "18:00"
  },
  "sameAs": [
    info.social.facebook,
    info.social.instagram
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
